# Copy to .env and adjust as needed:  cp .env.example .env

# Host user mapping for the bind mount. On Linux set these to `id -u` / `id -g`.
# On macOS (Docker Desktop) the defaults are fine.
UID=1000
GID=1000

# Xdebug: off | debug | develop | "debug,develop"
XDEBUG_MODE=off

# --- Host port mappings ---
# Caddy publishes on these. Defaults are 8080/8443 (-> https://blog.me:8443) so
# the stack comes up even when another local proxy (Herd, another compose stack)
# owns 80/443. Set HTTP_PORT=80 / HTTPS_PORT=443 for bare https://blog.me once
# nothing else is on those ports.
HTTP_PORT=8080
HTTPS_PORT=8443
# Bound to 127.0.0.1 and exposed only for host tooling (a DB GUI, redis-cli);
# the app reaches the services over the Docker network regardless. Offset from
# the standard ports to avoid clashing with a local mysql / redis / mailpit.
MARIADB_PORT=13306
REDIS_PORT=13379
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
MAILPIT_SMTP_PORT=11025
MAILPIT_UI_PORT=18025

# --- Persistent data (host bind mounts) ---
# MariaDB and MinIO write straight to the host filesystem so the data survives
# `docker compose down -v` and is easy to back up. Paths are relative to the
# project root; `./data/*` is already gitignored.
MARIADB_DATA_PATH=./data/mariadb
MINIO_DATA_PATH=./data/minio

# --- Database (MariaDB) ---
MARIADB_DATABASE=blog
MARIADB_USER=blog
MARIADB_PASSWORD=blog
MARIADB_ROOT_PASSWORD=root
DATABASE_URL=mysql://blog:blog@mariadb:3306/blog

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Object storage (MinIO / S3) ---
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=https://s3.blog.me
S3_REGION=us-east-1
S3_BUCKET=uploads
S3_KEY=minio
S3_SECRET=minio12345
S3_USE_PATH_STYLE=true
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio12345

# --- Mail (Mailpit) ---
MAILER_DSN=smtp://mailpit:1025
