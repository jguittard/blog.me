<?xml version="1.0"?>
<psalm
    cacheDirectory="./.psalm-cache"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
    errorLevel="1"
    findUnusedPsalmSuppress="true"
    findUnusedCode="true"
    findUnusedBaselineEntry="true"
    errorBaseline="psalm-baseline.xml"
>
    <issueHandlers>
        <MissingOverrideAttribute>
            <errorLevel type="suppress">
                <directory name="src" />
                <directory name="test" />
            </errorLevel>
        </MissingOverrideAttribute>

        <!--
            Psalm 6.13 does not model the PHP 8.5 `clone(...)` with-expression:
            it infers `object` from the call form, so the concrete `self` return
            types of the entity mutators read as too specific.
        -->
        <MoreSpecificReturnType>
            <errorLevel type="suppress">
                <directory name="src/App/src/Domain/Entity" />
            </errorLevel>
        </MoreSpecificReturnType>
        <LessSpecificReturnStatement>
            <errorLevel type="suppress">
                <directory name="src/App/src/Domain/Entity" />
            </errorLevel>
        </LessSpecificReturnStatement>

        <!--
            Virtual property hooks on the read models have no backing store and
            are never "set"; Psalm 6.13's hook support still expects constructor
            initialisation.
        -->
        <PropertyNotSetInConstructor>
            <errorLevel type="suppress">
                <directory name="src/App/src/Domain/ReadModel" />
            </errorLevel>
        </PropertyNotSetInConstructor>

        <!--
            The domain layer is an API surface consumed via the container and the
            hydrator (reflection), which findUnusedCode cannot see, and not every
            mutator has a caller yet.
        -->
        <PossiblyUnusedMethod>
            <errorLevel type="suppress">
                <directory name="src/App/src/Domain" />
            </errorLevel>
        </PossiblyUnusedMethod>
        <PossiblyUnusedProperty>
            <errorLevel type="suppress">
                <directory name="src/App/src/Domain" />
            </errorLevel>
        </PossiblyUnusedProperty>
    </issueHandlers>

    <projectFiles>
        <directory name="src"/>
        <directory name="test"/>
        <ignoreFiles>
            <directory name="vendor"/>
        </ignoreFiles>
    </projectFiles>
    <plugins>
        <pluginClass class="Psalm\PhpUnitPlugin\Plugin"/>
    </plugins>
</psalm>
