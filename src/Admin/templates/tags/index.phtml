<?php
/** @var \App\Domain\Entity\Tag[] $tags */
$this->headTitle('Tags');
?>
<div class="space-y-6">
    <div class="flex items-center justify-between">
        <h1 class="text-xl font-bold tracking-tight">Tags</h1>
        <a
            href="<?= $this->url('admin.tags.create') ?>"
            class="rounded-lg bg-primary px-3 py-2 text-sm font-medium text-white hover:bg-blue-700"
        >+ New tag</a>
    </div>

    <?php if ($tags === []): ?>
        <p class="rounded-lg border border-dashed border-gray-300 bg-white p-8 text-center text-sm text-gray-500">
            No tags yet.
        </p>
    <?php else: ?>
        <div class="overflow-hidden rounded-lg border border-gray-200 bg-white">
            <table class="w-full text-sm">
                <thead class="border-b border-gray-200 text-left text-xs uppercase tracking-wide text-gray-500">
                    <tr>
                        <th class="px-4 py-3 font-medium">Name</th>
                        <th class="px-4 py-3 font-medium">Slug</th>
                        <th class="px-4 py-3"></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    <?php foreach ($tags as $tag): ?>
                        <tr>
                            <td class="px-4 py-3">
                                <a
                                    href="<?= $this->url('admin.tags.edit', ['id' => $tag->id]) ?>"
                                    class="font-medium text-gray-900 hover:text-primary"
                                ><?= $this->escapeHtml($tag->name) ?></a>
                            </td>
                            <td class="px-4 py-3 font-mono text-xs text-gray-500"><?= $this->escapeHtml((string) $tag->slug) ?></td>
                            <td class="px-4 py-3 text-right">
                                <form
                                    method="post"
                                    action="<?= $this->url('admin.tags.delete', ['id' => $tag->id]) ?>"
                                    onsubmit="return confirm('Delete this tag?')"
                                >
                                    <button type="submit" class="text-xs font-medium text-red-600 hover:underline">Delete</button>
                                </form>
                            </td>
                        </tr>
                    <?php endforeach; ?>
                </tbody>
            </table>
        </div>
    <?php endif; ?>
</div>
