<?php
/** @var \App\Domain\ReadModel\PostListItem $post */
?>
<article class="group rounded-lg border border-gray-200 bg-white p-5 transition-shadow hover:shadow-sm">
    <div class="flex flex-wrap items-center gap-2 text-xs text-gray-500">
        <?php if ($post->categoryName !== null && $post->categorySlug !== null): ?>
            <a
                href="<?= $this->url('blog.category', ['slug' => $post->categorySlug]) ?>"
                class="rounded-md bg-primary/10 px-2 py-0.5 font-medium text-primary transition-colors hover:bg-primary/20"
            ><?= $this->escapeHtml($post->categoryName) ?></a>
        <?php endif; ?>
        <?php if ($post->publishedAt !== null): ?>
            <time datetime="<?= $post->publishedAt->format('c') ?>"><?= $post->publishedAt->format('M j, Y') ?></time>
        <?php endif; ?>
        <?php if ($post->isNew): ?>
            <span class="rounded-md border border-primary/20 bg-primary/10 px-1.5 py-0.5 font-medium text-primary">New</span>
        <?php endif; ?>
    </div>

    <h2 class="mt-2 text-lg font-semibold tracking-tight">
        <a class="transition-colors group-hover:text-primary" href="<?= $this->url('blog.post', ['slug' => $post->slug]) ?>">
            <?= $this->escapeHtml($post->title) ?>
        </a>
    </h2>

    <p class="mt-2 text-sm leading-6 text-gray-600"><?= $this->escapeHtml($post->summary) ?></p>

    <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-gray-500">
        <span>By <?= $this->escapeHtml($post->authorName) ?></span>
        <?php foreach ($post->tags as $tag): ?>
            <span class="rounded bg-gray-100 px-1.5 py-0.5 text-gray-600"><?= $this->escapeHtml($tag) ?></span>
        <?php endforeach; ?>
    </div>
</article>
