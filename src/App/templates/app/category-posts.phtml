<?php
/** @var \App\Domain\Entity\Category $category */
/** @var \App\Domain\ReadModel\PostListItem[] $posts */
/** @var int $page */
/** @var bool $hasPrev */
/** @var bool $hasNext */
$this->headTitle($category->name);
?>
<div class="space-y-8">
    <header class="space-y-2">
        <a href="<?= $this->url('blog.categories') ?>" class="text-xs text-gray-400 transition-colors hover:text-gray-600">
            &larr; All categories
        </a>
        <h1 class="text-2xl font-bold tracking-tight"><?= $this->escapeHtml($category->name) ?></h1>
        <?php if ($category->description !== null): ?>
            <p class="text-sm text-gray-500"><?= $this->escapeHtml($category->description) ?></p>
        <?php endif; ?>
    </header>

    <?php if ($posts === []): ?>
        <p class="rounded-lg border border-dashed border-gray-300 bg-white p-8 text-center text-sm text-gray-500">
            No posts in this category yet.
        </p>
    <?php else: ?>
        <div class="space-y-4">
            <?php foreach ($posts as $post): ?>
                <?= $this->render('app::partial/post-card', ['post' => $post]) ?>
            <?php endforeach; ?>
        </div>
    <?php endif; ?>

    <?php if ($hasPrev || $hasNext): ?>
        <nav class="flex items-center justify-between border-t border-gray-200 pt-6 text-sm">
            <?php if ($hasPrev): ?>
                <a class="font-medium text-primary hover:underline" href="?page=<?= $page - 1 ?>">&larr; Newer</a>
            <?php else: ?>
                <span></span>
            <?php endif; ?>
            <?php if ($hasNext): ?>
                <a class="font-medium text-primary hover:underline" href="?page=<?= $page + 1 ?>">Older &rarr;</a>
            <?php else: ?>
                <span></span>
            <?php endif; ?>
        </nav>
    <?php endif; ?>
</div>
